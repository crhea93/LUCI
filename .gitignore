# added; they are fully regenerated by running the example.
Luci_outputs/
Data/ExampleData/*_map.png
*.pkl

# Test artifacts (fixture cubes are built at test time; *.hdf5 already ignored)
.pytest_cache/

# Sphinx build output.  GitHub Pages serves the FLATTENED html at the docs/
# root (docs/index.html + docs/*.html + docs/_static); the build trees below
# were stale duplicates (~34 MB) of that same output and are regenerated by
# `sphinx-build`.  Do not ignore docs/_static or the served docs/*.html.
docs/build/
docs/_build/
